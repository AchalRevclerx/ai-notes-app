APP_NAME="AI Notes"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Docker Compose overrides the DB/Redis/queue values below with container hostnames.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=notes
DB_USERNAME=notes
DB_PASSWORD=notes_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --- AI -----------------------------------------------------------------
# AI_DRIVER: "openai" (any OpenAI-compatible API) or "local" (offline fallback).
# Defaults to "openai" when AI_API_KEY is set, otherwise "local".
# AI_DRIVER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Fixed at migration time (pgvector column size). Run `php artisan notes:reindex --all` after changing provider/model.
AI_EMBEDDING_DIMENSIONS=768
AI_TIMEOUT=30
# Minimum cosine similarity (0..1) for a search hit. Default: 0.3 (openai), 0.1 (local).
# AI_SEARCH_MIN_SIMILARITY=0.3

# API tokens expire after this many minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
